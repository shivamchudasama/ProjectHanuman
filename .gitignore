# Ignore Build Artifacts
build*/
/.vscode/
workspace.code-workspace
.codex/config.toml
__pycache__/
.coverage
# Office lock files (e.g. Sample Code FS/_DOC/Flow Diagrams)
~$*

# Local certificate authority (holds the CA private key)
_CA/

# Private OEM seed -> key algorithms (_ASW/_UDS/oem, _DOC/UDS/README.md)
_ASW/_UDS/oem/

# Chromium crashpad output (VS Code)
debug.log
